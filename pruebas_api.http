@url = http://localhost:3000/api

# ejemplos de peticiones para probar la API

# health check para ver si el server esta encendido
GET {{url}}/health

###

# TEST SLACK (error 401) 
# OJO: Los errores 400 (como este 401 Unauthorized por mala contraseña) NO llegan a Slack.
# La API es lo suficientemente lista para saber que esto es culpa del cliente y no satura Slack.
POST {{url}}/user/login
Content-Type: application/json

{
  "email": "noexiste@ejemplo.com",
  "password": "contraseñaerronea"
}

###

# TEST SLACK REAL - Forzar un error 500 en el servidor
# Al ejecutar esto, SÍ que te llegará un mensaje al canal de Slack.
GET {{url}}/test-slack

###

# registro de usuario nuevo
# OJO: name y lastName son obligatorios
# el codigo de verificacion sale en la consola del servidor
POST {{url}}/user/register
Content-Type: application/json

{
  "name": "Alejandro",
  "lastName": "Montero",
  "email": "esun@ejemplo.com",
  "password": "Password123!"
}

###

# validar el email con el codigo de 6 digitos que sale en consola
# hay que poner el accessToken del paso anterior en el header
PUT {{url}}/user/validation
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "code": "AQUI_TU_CODIGO_DE_CONSOLA"
}

###

# login normal, devuelve accessToken y refreshToken
POST {{url}}/user/login
Content-Type: application/json

{
  "email": "profe@ejemplo.com",
  "password": "Password123!"
}

###

# ver perfil del usuario autenticado
GET {{url}}/user
Authorization: Bearer AQUI_TU_TOKEN

###

# rellenar nombre y apellidos (onboarding paso 1)
PUT {{url}}/user/register
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "name": "Alejandro",
  "lastName": "Montero",
  "nif": "12345678A"
}

###

# asociar empresa - en este caso como freelance
PATCH {{url}}/user/company
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "isFreelance": true,
  "address": {
    "city": "Madrid",
    "street": "Gran Via"
  }
}

###

# invitar compañeros a la empresa (solo si eres admin y tienes empresa asignada)
# el servidor crea los usuarios en la BD con role guest
# puedes poner varios emails separados por comas
POST {{url}}/user/invite?emails=compañero1@empresa.com,compañero2@empresa.com
Authorization: Bearer AQUI_TU_TOKEN

###

# subir logo de la empresa
# Nota: La extensión REST Client permite subir archivos usando esta sintaxis de boundaries.
# Necesitas tener una imagen llamada "logo.png" en la misma carpeta que este archivo.
PATCH {{url}}/user/logo
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

< ./logo.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# cambiar contrasena
PUT {{url}}/user/password
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "currentPassword": "Password123!",
  "newPassword": "NuevaPassword456!"
}

###

# cerrar sesion (invalida los refresh tokens)
POST {{url}}/user/logout
Authorization: Bearer AQUI_TU_TOKEN

###

# eliminar cuenta, con ?soft=true la deja como "borrada" pero sin eliminar de la BD
DELETE {{url}}/user?soft=true
Authorization: Bearer AQUI_TU_TOKEN

###

# ========================================
# =             CLIENTES                 =
# ========================================

# Crear un cliente
POST {{url}}/client
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "name": "Cliente de Prueba",
  "cif": "B12345678",
  "address": {
    "street": "Calle Mayor 1",
    "city": "Madrid",
    "postalCode": "28001",
    "province": "Madrid"
  }
}

###

# Listar clientes
GET {{url}}/client
Authorization: Bearer AQUI_TU_TOKEN

###

# Obtener un cliente por ID
GET {{url}}/client/AQUI_ID_DEL_CLIENTE
Authorization: Bearer AQUI_TU_TOKEN

###

# Actualizar un cliente
PUT {{url}}/client/AQUI_ID_DEL_CLIENTE
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "name": "Cliente Actualizado",
  "phone": "600123456"
}

###

# Archivar un cliente (soft delete: queda en BD marcado como eliminado)
DELETE {{url}}/client/AQUI_ID_DEL_CLIENTE?soft=true
Authorization: Bearer AQUI_TU_TOKEN

###

# Borrar un cliente definitivamente (hard delete: se elimina de la BD)
DELETE {{url}}/client/AQUI_ID_DEL_CLIENTE
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar clientes archivados (soft deleted)
GET {{url}}/client/archived
Authorization: Bearer AQUI_TU_TOKEN

###

# Restaurar un cliente archivado
PATCH {{url}}/client/AQUI_ID_DEL_CLIENTE/restore
Authorization: Bearer AQUI_TU_TOKEN

###

# ========================================
# =             PROYECTOS                =
# ========================================

# Crear un proyecto
POST {{url}}/project
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "name": "Proyecto Reformas",
  "projectCode": "PRJ-001",
  "client": "AQUI_ID_DEL_CLIENTE"
}

###

# Listar proyectos (sin filtros)
GET {{url}}/project
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar proyectos filtrados por nombre (búsqueda parcial)
GET {{url}}/project?name=Reforma
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar proyectos activos ordenados por fecha de creación descendente
GET {{url}}/project?active=true&sort=-createdAt
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar proyectos de un cliente concreto
GET {{url}}/project?client=AQUI_ID_DEL_CLIENTE
Authorization: Bearer AQUI_TU_TOKEN

###

# Obtener un proyecto por ID
GET {{url}}/project/AQUI_ID_DEL_PROYECTO
Authorization: Bearer AQUI_TU_TOKEN

###

# Actualizar un proyecto
PUT {{url}}/project/AQUI_ID_DEL_PROYECTO
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "name": "Proyecto Reformas Actualizado"
}

###

# Archivar un proyecto (soft delete)
DELETE {{url}}/project/AQUI_ID_DEL_PROYECTO
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar proyectos archivados (soft deleted)
GET {{url}}/project/archived
Authorization: Bearer AQUI_TU_TOKEN

###

# ========================================
# =             ALBARANES                =
# ========================================

# Crear un albarán (formato horas)
POST {{url}}/deliverynote
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "client": "AQUI_ID_DEL_CLIENTE",
  "project": "AQUI_ID_DEL_PROYECTO",
  "format": "hours",
  "hours": 5,
  "description": "Revisión de planos e instalación electrica",
  "workdate": "2024-05-01T08:00:00Z"
}

###

# Crear un albarán (formato material)
POST {{url}}/deliverynote
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: application/json

{
  "client": "AQUI_ID_DEL_CLIENTE",
  "project": "AQUI_ID_DEL_PROYECTO",
  "format": "material",
  "material": "Cemento Portland 25kg",
  "description": "Entrega de material para cimentación",
  "workdate": "2024-05-02T08:00:00Z"
}

###

# Listar albaranes (sin filtros)
GET {{url}}/deliverynote
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar albaranes de tipo horas
GET {{url}}/deliverynote?format=hours
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar albaranes firmados
GET {{url}}/deliverynote?signed=true
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar albaranes pendientes de firma
GET {{url}}/deliverynote?signed=false
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar albaranes por rango de fechas
GET {{url}}/deliverynote?from=2024-01-01&to=2024-12-31
Authorization: Bearer AQUI_TU_TOKEN

###

# Listar albaranes de un proyecto, ordenados por fecha de trabajo descendente
GET {{url}}/deliverynote?project=AQUI_ID_DEL_PROYECTO&sort=-workdate
Authorization: Bearer AQUI_TU_TOKEN

###

# Obtener un albarán por ID (con populate de cliente, proyecto y usuario)
GET {{url}}/deliverynote/AQUI_ID_ALBARAN
Authorization: Bearer AQUI_TU_TOKEN

###

# Descargar PDF (Cambiar ID en la URL)
GET {{url}}/deliverynote/AQUI_ID_ALBARAN/pdf
Authorization: Bearer AQUI_TU_TOKEN

###

# Firmar albarán (Sube la firma a Cloudinary)
# Necesitas tener una imagen llamada "firma.png" en la misma carpeta que este archivo
PATCH {{url}}/deliverynote/AQUI_ID_ALBARAN/sign
Authorization: Bearer AQUI_TU_TOKEN
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="signature"; filename="firma.png"
Content-Type: image/png

< ./firma.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# Borrar un albarán (solo funciona si NO está firmado)
# Si está firmado, devolverá error 400
DELETE {{url}}/deliverynote/AQUI_ID_ALBARAN
Authorization: Bearer AQUI_TU_TOKEN

###
